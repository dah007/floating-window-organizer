<Window x:Class="FloatingWindowOrganizer.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget color"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <!-- Checkerboard shown behind translucent colours. -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4" />
                                <RectangleGeometry Rect="4,4,4,4" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Round preset swatch: just the colour, with a ring on hover and keyboard focus. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="#80808080" StrokeThickness="1" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="256">
        <!-- Saturation (left to right) and brightness (top to bottom) for the current hue. -->
        <Grid x:Name="SvArea"
              Height="168"
              Cursor="Cross"
              Background="Transparent"
              MouseLeftButtonDown="Area_MouseLeftButtonDown"
              MouseMove="Area_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp"
              SizeChanged="Area_SizeChanged">
            <Border x:Name="HueFill" CornerRadius="8" Background="Red" />
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Full-spectrum hue bar. -->
        <TextBlock Text="Hue" Margin="0,14,0,4" FontSize="12" />
        <Grid x:Name="HueArea"
              Height="16"
              Cursor="Hand"
              Background="Transparent"
              MouseLeftButtonDown="Area_MouseLeftButtonDown"
              MouseMove="Area_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp"
              SizeChanged="Area_SizeChanged">
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                <Ellipse x:Name="HueThumb" Width="18" Height="18" Canvas.Top="-1" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Opacity: from see-through glass to solid. -->
        <DockPanel Margin="0,12,0,4">
            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" FontSize="12" />
            <TextBlock Text="Opacity" FontSize="12" />
        </DockPanel>
        <Grid x:Name="AlphaArea"
              Height="16"
              Cursor="Hand"
              Background="Transparent"
              MouseLeftButtonDown="Area_MouseLeftButtonDown"
              MouseMove="Area_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp"
              SizeChanged="Area_SizeChanged">
            <Border CornerRadius="8" Background="{StaticResource CheckerBrush}" />
            <Border x:Name="AlphaFill" CornerRadius="8" />
            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                <Ellipse x:Name="AlphaThumb" Width="18" Height="18" Canvas.Top="-1" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Preview with the automatic text colour, and hex entry. -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="96" Height="44" CornerRadius="12" Background="{StaticResource CheckerBrush}">
                <Border x:Name="PreviewSwatch" CornerRadius="12">
                    <TextBlock x:Name="PreviewText"
                               Text="Aa"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Label Content="_Hex" Target="{Binding ElementName=HexBox}" Padding="0,0,0,2" FontSize="12" />
                <TextBox x:Name="HexBox"
                         MaxLength="9"
                         KeyDown="HexBox_KeyDown"
                         LostKeyboardFocus="HexBox_LostKeyboardFocus" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Presets" Margin="0,16,0,6" FontSize="12" />
        <WrapPanel x:Name="PresetPanel" />

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="_Default" MinWidth="80" Click="Default_Click"
                    ToolTip="Go back to the Windows light or dark colour" />
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="80" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="OK" MinWidth="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
        </DockPanel>
    </StackPanel>
</Window>
