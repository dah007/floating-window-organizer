<Window x:Class="FloatingWindowOrganizer.App.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FloatingWindowOrganizer.App"
        Title="Folder widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <!-- Rename box: fits the 18 px title row and looks like the title, on a faint tile. -->
        <Style x:Key="TitleEditorStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource WidgetTextBrush}" />
            <Setter Property="MaxLength" Value="64" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{DynamicResource WidgetTileHoverBrush}" CornerRadius="4" Padding="3,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="Card"
            CornerRadius="22"
            Background="{DynamicResource WidgetTintBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="2"
            Padding="13,11,13,11"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            MouseMove="Card_MouseMove"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="Refresh" Click="Refresh_Click" />
                <MenuItem x:Name="CollapseItem" Header="Collapse" Click="ToggleCollapsed_Click" />
                <Separator />
                <MenuItem Header="Open in File Explorer" Click="OpenInExplorer_Click" />
                <MenuItem Header="Change folder…" Click="ChangeFolder_Click" />
                <MenuItem Header="Rename" Click="Rename_Click" />
                <MenuItem Header="Color…" Click="Color_Click" />
                <MenuItem x:Name="GlossItem" Header="Glossy" IsCheckable="True" Click="Gloss_Click" />
                <MenuItem Header="Size">
                    <MenuItem x:Name="SizeSmallItem" Header="Small" Tag="Small" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeMediumItem" Header="Medium" Tag="Medium" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeLargeItem" Header="Large" Tag="Large" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeExtraLargeItem" Header="Extra large" Tag="ExtraLarge" IsCheckable="True" Click="Size_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Add widget…" Click="AddWidget_Click" />
                <MenuItem Header="Remove widget" Click="RemoveWidget_Click" />
                <Separator />
                <MenuItem Header="About" Click="About_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
        <!-- Glossy glass, under the content and over the tint (see WidgetPalette for the recipe). The
             negative margin cancels the card padding so the layers reach the card's inner edge. Purely
             decorative: never hit-testable, so clicks, drags and double-clicks reach the card. -->
        <Grid x:Name="Gloss" Margin="-13,-11" IsHitTestVisible="False" Focusable="False"
              Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossVeilBrush}" />
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossBrush}" />
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossStreakBrush}" />
        </Grid>

        <!-- Fixed to the expanded content height (set in code) and top-aligned, so while the widget
             collapses the tiles are clipped rather than squashed. -->
        <DockPanel x:Name="ContentPanel" VerticalAlignment="Top">
            <!-- Title row. Transparent background so double-clicking anywhere on it collapses/expands. -->
            <DockPanel x:Name="TitleRow" DockPanel.Dock="Top" Height="18" Margin="4,0,4,6" Background="Transparent">
                <TextBlock x:Name="ItemCountText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource WidgetSecondaryTextBrush}" />
                <Grid>
                    <TextBlock x:Name="FolderNameText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource WidgetTextBrush}" />
                    <TextBox x:Name="NameEditor"
                             Style="{StaticResource TitleEditorStyle}"
                             Visibility="Collapsed"
                             Margin="-3,0,8,0"
                             KeyDown="NameEditor_KeyDown"
                             LostKeyboardFocus="NameEditor_LostKeyboardFocus" />
                </Grid>
            </DockPanel>

            <ItemsControl x:Name="Tiles" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Rows="{Binding GridRows, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:TileViewModel}">
                        <!-- Transparent background so the whole cell is hit-testable for double-click. -->
                        <Grid Background="Transparent" ToolTip="{Binding TargetPath}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WidgetTileBrush}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WidgetTileHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WidgetTileEdgeBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- The tile's own small glare (glossy only). -->
                                        <Border CornerRadius="9" Background="{DynamicResource WidgetTileGlossBrush}" IsHitTestVisible="False"
                                                Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
                                        <Image Source="{Binding Icon}"
                                               Width="32"
                                               Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding OverflowText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WidgetTextBrush}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}"
                                           Margin="0,2,0,0"
                                           MaxWidth="64"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource WidgetTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        </Grid>
    </Border>

    <!-- Glossy edge over the card's own 2 px border: a lighter shade of the tint along the top, a darker one along the bottom. -->
    <Border x:Name="GlossRim" CornerRadius="22" BorderThickness="2" IsHitTestVisible="False" Focusable="False"
            BorderBrush="{DynamicResource WidgetGlossRimBrush}"
            Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
    </Grid>
</Window>
