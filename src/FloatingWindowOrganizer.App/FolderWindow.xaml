<Window x:Class="FloatingWindowOrganizer.App.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FloatingWindowOrganizer.App"
        Title="Folder widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Border x:Name="Card"
            CornerRadius="22"
            Background="{DynamicResource WidgetTintBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1"
            Padding="14,12,14,12"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            MouseMove="Card_MouseMove"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="Refresh" Click="Refresh_Click" />
                <MenuItem x:Name="CollapseItem" Header="Collapse" Click="ToggleCollapsed_Click" />
                <Separator />
                <MenuItem Header="Open in File Explorer" Click="OpenInExplorer_Click" />
                <MenuItem Header="Change folder…" Click="ChangeFolder_Click" />
                <MenuItem Header="Size">
                    <MenuItem x:Name="SizeSmallItem" Header="Small" Tag="Small" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeMediumItem" Header="Medium" Tag="Medium" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeLargeItem" Header="Large" Tag="Large" IsCheckable="True" Click="Size_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Add widget…" Click="AddWidget_Click" />
                <MenuItem Header="Remove widget" Click="RemoveWidget_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Fixed to the expanded content height (set in code) and top-aligned, so while the widget
             collapses the tiles are clipped rather than squashed. -->
        <DockPanel x:Name="ContentPanel" VerticalAlignment="Top">
            <!-- Title row. Transparent background so double-clicking anywhere on it collapses/expands. -->
            <DockPanel x:Name="TitleRow" DockPanel.Dock="Top" Height="18" Margin="4,0,4,6" Background="Transparent">
                <TextBlock x:Name="ItemCountText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource WidgetSecondaryTextBrush}" />
                <TextBlock x:Name="FolderNameText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource WidgetTextBrush}" />
            </DockPanel>

            <ItemsControl x:Name="Tiles" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Rows="{Binding GridRows, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:TileViewModel}">
                        <!-- Transparent background so the whole cell is hit-testable for double-click. -->
                        <Grid Background="Transparent" ToolTip="{Binding TargetPath}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WidgetTileBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WidgetTileHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding Icon}"
                                               Width="32"
                                               Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding OverflowText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WidgetTextBrush}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}"
                                           Margin="0,2,0,0"
                                           MaxWidth="64"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource WidgetTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
