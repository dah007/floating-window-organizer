<Window x:Class="FloatingWindowOrganizer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Floating Window Organizer"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <!-- A link row: icon, label over address, external-link arrow. Colours are set per theme in code. -->
        <Style x:Key="LinkRowStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource AboutRowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AboutRowBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AboutTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoffeeRowStyle" TargetType="Button" BasedOn="{StaticResource LinkRowStyle}">
            <Setter Property="Background" Value="#FFB020" />
            <Setter Property="BorderBrush" Value="#FFB020" />
            <Setter Property="Foreground" Value="#1C1C1E" />
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AboutSecondaryTextBrush}" />
        </Style>

        <Geometry x:Key="ExternalArrow">M7,13 L13,7 M8,7 L13,7 L13,12</Geometry>
    </Window.Resources>

    <StackPanel>
        <StackPanel Margin="28,20,28,24">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/app-256.png"
                       Width="64"
                       Height="64"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="Floating Window Organizer"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AboutTextBrush}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                    <TextBlock x:Name="TaglineText"
                               Margin="0,8,0,0"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AboutTextBrush}" />
                </StackPanel>
            </DockPanel>

            <Button x:Name="GitHubButton" Style="{StaticResource LinkRowStyle}" Margin="0,20,0,0" Click="Link_Click">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" Stretch="None"
                          Data="M7,6 L3,10 L7,14 M13,6 L17,10 L13,14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path DockPanel.Dock="Right" Width="20" Height="20" Stretch="None" Data="{StaticResource ExternalArrow}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GitHub" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="GitHubText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button x:Name="LinkedInButton" Style="{StaticResource LinkRowStyle}" Margin="0,8,0,0" Click="Link_Click">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" Stretch="None"
                          Data="M5,7 L15,7 A2,2 0 0 1 17,9 L17,15 A2,2 0 0 1 15,17 L5,17 A2,2 0 0 1 3,15 L3,9 A2,2 0 0 1 5,7 Z M7.5,7 L7.5,5.5 A1,1 0 0 1 8.5,4.5 L11.5,4.5 A1,1 0 0 1 12.5,5.5 L12.5,7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" />
                    <Path DockPanel.Dock="Right" Width="20" Height="20" Stretch="None" Data="{StaticResource ExternalArrow}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LinkedIn" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="LinkedInText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button x:Name="CoffeeButton" Style="{StaticResource CoffeeRowStyle}" Margin="0,8,0,0" Click="Link_Click">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" Stretch="None"
                          Data="M4,8 L14,8 L14,12 A4,4 0 0 1 10,16 L8,16 A4,4 0 0 1 4,12 Z M14,9.5 L15,9.5 A2,2 0 0 1 15,13.5 L13.7,13.5 M7.5,3.5 L7.5,5.5 M10.5,3.5 L10.5,5.5"
                          Stroke="#1C1C1E"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path DockPanel.Dock="Right" Width="20" Height="20" Stretch="None" Data="{StaticResource ExternalArrow}"
                          Stroke="#1C1C1E"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Buy me a coffee" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" />
                        <TextBlock x:Name="CoffeeText" FontSize="12" Foreground="#1C1C1E" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </StackPanel>

        <Border Background="{DynamicResource AboutFooterBrush}"
                BorderBrush="{DynamicResource AboutRowBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Close"
                        MinWidth="96"
                        IsDefault="True"
                        IsCancel="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Close_Click" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                    <Run Text="Open source under the" />
                    <Hyperlink x:Name="LicenseLink" Click="Link_Click">Apache License 2.0</Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
