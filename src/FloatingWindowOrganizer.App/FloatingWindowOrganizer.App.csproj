<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (System.Windows.Forms.NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FloatingWindowOrganizer.App</RootNamespace>
    <AssemblyName>FloatingWindowOrganizer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>iOS-style folder widgets for the Windows desktop.</Description>
    <!-- Application.ThemeMode (Fluent theme that follows Windows light/dark + accent) is flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Settings used by `dotnet publish` for the installer: self-contained, so users don't need .NET installed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms types out of the global namespace so Application, MessageBox etc. stay WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime for the tray icon. -->
    <Resource Include="Assets\app.ico" />
    <!-- Shown at 64 px in the About dialog (an .ico would decode at its first, smallest size). -->
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloatingWindowOrganizer.Core\FloatingWindowOrganizer.Core.csproj" />
  </ItemGroup>

</Project>
